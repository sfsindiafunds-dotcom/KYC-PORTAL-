rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedEmail() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return verifiedEmail() && (
        request.auth.token.email == 'sfsindiafunds@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function clientOwns(clientId) {
      return signedIn() && (
        clientId == request.auth.uid ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }

    function clientEditableFields() {
      return [
        'fullName', 'dateOfBirth', 'gender', 'maritalStatus', 'mobile',
        'pan', 'aadhaarNumber', 'aadhaarLast4', 'aadhaarConsentGranted',
        'address', 'occupation', 'annualIncome', 'nominee', 'documents',
        'consentCheckbox', 'submittedAt', 'resubmittedAt', 'updatedAt'
      ];
    }

    match /admins/{adminId} {
      allow get: if verifiedEmail() && (isAdmin() || request.auth.uid == adminId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && adminId != request.auth.uid;
    }

    match /clients/{clientId} {
      allow get: if isAdmin() || clientOwns(clientId);
      allow list: if isAdmin() || (
        signedIn() && resource.data.userId == request.auth.uid
      );

      allow create: if isAdmin() || (
        signedIn() &&
        clientId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'draft' &&
        request.resource.data.keys().hasOnly([
          'userId', 'email', 'status', 'createdAt', 'updatedAt', 'documents',
          'fullName', 'dateOfBirth', 'gender', 'maritalStatus', 'mobile',
          'pan', 'aadhaarNumber', 'aadhaarLast4', 'aadhaarConsentGranted',
          'address', 'occupation', 'annualIncome', 'nominee',
          'consentCheckbox', 'submittedAt', 'resubmittedAt', 'applicationId'
        ])
      );

      allow update: if isAdmin() || (
        clientOwns(clientId) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(clientEditableFields()) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
          (
            resource.data.status in ['draft', 'resubmission_requested', 'correction_requested'] &&
            request.resource.data.status in ['pending', 'resubmitted'] &&
            request.resource.data.consentCheckbox == true
          )
        ) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['consentCheckbox']) ||
          request.resource.data.consentCheckbox == true
        )
      );

      allow delete: if isAdmin();
    }

    match /invitations/{inviteId} {
      allow get: if isAdmin() || (
        signedIn() && resource.data.email == request.auth.token.email
      );
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if signedIn() &&
        request.resource.data.actorId == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'action', 'actorId', 'actorEmail', 'targetApplicationId', 'details', 'timestamp'
        ]);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
